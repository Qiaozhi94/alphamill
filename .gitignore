__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
dist/
build/
*.egg-info/
.idea/
.vscode/
.DS_Store

# 本机 AI 工具本地授权配置：含本机用户名路径与本地授权，不可移植
.claude/settings.local.json

# 编辑器本地历史
.history/

# 本机代理运行续接状态
.sisyphus/

# 本机 OpenCode 运行状态（含会话转录，严禁入库——密钥扫描门禁的原因之一）
.omo/

# 本机 ZCode CLI 运行状态（会话计划等，不入库）
.zcode/

# 仿真/实验产生的数据与输出
data/raw/
data/processed/
results/
artifacts/
*.parquet
*.feather

# 本地-only 文档（保留在磁盘，不纳入 git）
docs/research/
docs/reviews/*
# ...例外：curated 摘要入库
!docs/reviews/RETROSPECTIVE.md
# ...例外：owner 明确要求入库的过程稿归档（原文照搬，仅存档用）
!docs/reviews/archive/
!docs/reviews/archive/**

# 本地运行时密钥（模板为 deployment/.env.example，真实凭据人工搬运不进 git）
deployment/.env

# Kronos 上游克隆（pin 记录见 vendor/VENDORED.md）与模型权重（migration-plan §三：不进 git）
vendor/Kronos/
models/
# ...例外：AlphaGen vendor 的 alphagen/models/ 是上游源码（线性协同池），不是模型权重；
# 裸 models/ 规则会把它整目录吞掉，必须显式放回（见 alphagen_vendor/VENDORED.md）。
!src/alphamill/factor_factory/generators/alphagen_vendor/alphagen/models/
deployment/backups/

!.gitkeep

# Freqtrade dry-run 运行时数据库（本地状态，不进 git）
freqtrade/user_data/tradesv3.sqlite*

# F002 Parquet 湖（分区数据 + manifest + symbol-map artifact，NAS 备份，不进 git）
lake/

# F003 生成运行产物（run.json/因子/checkpoint，体积大；只入库 curated 摘要）
reports/generation/
# GPU 单槽的运行期锁与队列文件（gpu.slot/gpu.queue，纯本机运行态）
reports/.locks/
reports/backfill/*.log
# 逐片进度日志（stderr，体积大且可重跑复现）：入库只留逐片摘要 *.log.json 与 run.json
reports/backfill/*.log.err
