          "rawSql": "WITH priced AS (SELECT exchange, symbol, time, close, LAG(close) OVER (PARTITION BY exchange, symbol ORDER BY time) AS prev_close FROM ohlcv_1m), moves AS (SELECT CASE WHEN prev_close IS NULL OR prev_close = 0 THEN NULL ELSE (close - prev_close) / prev_close END AS return_pct FROM priced) SELECT COUNT(*) AS abnormal_rows FROM moves WHERE ABS(return_pct) > 0.50;",
