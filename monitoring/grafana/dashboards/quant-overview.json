          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ranges AS (SELECT exchange, symbol, MIN(time) AS first_time, MAX(time) AS last_time FROM ohlcv_1m GROUP BY exchange, symbol), expected AS (SELECT r.exchange, r.symbol, generate_series(r.first_time, r.last_time, INTERVAL '1 minute') AS time FROM ranges r), missing AS (SELECT e.exchange, e.symbol, e.time FROM expected e LEFT JOIN ohlcv_1m o ON o.exchange = e.exchange AND o.symbol = e.symbol AND o.time = e.time WHERE o.time IS NULL) SELECT COUNT(*) AS missing_rows FROM missing;",
          "refId": "A"
        }
      ],
      "title": "Missing 1m Candles",
      "type": "stat"
