# F001 authoritative, left-closed/right-open historical backfill window (UTC).
BACKFILL_WINDOW_START=2024-09-10T00:00:00Z
BACKFILL_WINDOW_END=2026-09-10T15:52:00Z
EXCHANGES=binance
DERIVATIVES_EXCHANGE=binanceusdm
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT
# Optional explicit availability boundaries. Format: SYMBOL=ISO_TIMESTAMP,...
BACKFILL_SYMBOL_LISTING_STARTS=
# Optional delisting boundaries. The timestamp is the first unavailable candle.
BACKFILL_SYMBOL_DELISTING_ENDS=
# Symbols explicitly known to be unavailable for the whole window.
BACKFILL_UNAVAILABLE_SYMBOLS=
# Binance USDM open-interest history is available for the latest 30 days only.
DERIVATIVES_OPEN_INTEREST_MAX_DAYS=30
