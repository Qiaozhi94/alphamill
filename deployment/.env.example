DB_USER=quant
DB_PASSWORD=change-me
DB_NAME=quant
EXCHANGES=binance
DERIVATIVES_EXCHANGE=binanceusdm
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT
TIMEFRAMES=1m
POLL_SECONDS=30
FETCH_LIMIT=5
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
FREQTRADE_API_USERNAME=admin
FREQTRADE_API_PASSWORD=change-me-freqtrade-password-32-chars
FREQTRADE_JWT_SECRET_KEY=change-me-freqtrade-jwt-secret-32-chars
FREQTRADE_WS_TOKEN=change-me-freqtrade-ws-token-32-chars
# 真实推理不在本文件切换：默认服务固定 mock，真实实例用 --profile kronos-real
KRONOS_MODEL=models/Kronos-base
KRONOS_TOKENIZER=models/Kronos-Tokenizer-base
KRONOS_DEVICE=cpu

# Kronos 生命周期控制面（F009 FR-007）。值域与默认值见该 spec；非法值启动期判红，
# 不静默回退默认。三个 deadline 都是**服务端**处理/动作 deadline，客户端 socket
# deadline 另算且必须更大（缺省 +5s 余量）。
# GPU 镜像构建时 torch 依赖的**额外** PyPI 索引（F010 R1-004）：缺省不设 = 只用 cu130 索引。
# 仅在本机到 pypi.nvidia.com 不通时按需启用，值由构建机自己决定，不写进 compose 契约。
# TORCH_EXTRA_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

KRONOS_VRAM_PROBE_MODE=auto
KRONOS_VRAM_PROBE_TIMEOUT_S=2
KRONOS_LIFECYCLE_STATUS_TIMEOUT_S=5
KRONOS_LIFECYCLE_STOP_TIMEOUT_S=60
KRONOS_LIFECYCLE_RESTORE_TIMEOUT_S=120
